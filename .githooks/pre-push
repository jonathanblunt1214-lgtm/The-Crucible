#!/bin/sh
# Local safety net: run the fast, offline subset of The Crucible's own
# verification suite before a push leaves this machine, so a red state
# never reaches GitHub in the first place. Installed automatically by
# src/installGitHooks.js on every `npm install`/`npm ci` (see that file
# for why the executable bit matters here).
set -e

echo "[The Crucible] Running local pre-push verification..."
npm run lint:workflows
npm run docs:check
npm test
npm run validate
npm run audit:clutter
npm run audit:privacy
npm run audit:security
echo "[The Crucible] Pre-push verification passed."
