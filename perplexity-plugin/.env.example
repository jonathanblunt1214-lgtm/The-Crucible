# ─────────────────────────────────────────────
# Perplexity Plugin — Environment Configuration
# Copy to .env (never commit .env)
# ─────────────────────────────────────────────

# ── Crucible MCP endpoint ────────────────────
# Required: deployed HTTPS URL for /mcp
# Example: https://the-crucible.onrender.com/mcp
CRUCIBLE_MCP_URL=

# Auth mode for the /mcp endpoint
# Values: none | bearer
CRUCIBLE_MCP_AUTH_MODE=none

# Bearer token (only used when CRUCIBLE_MCP_AUTH_MODE=bearer)
CRUCIBLE_MCP_BEARER_TOKEN=

# ── AI Collaboration (config-gated) ──────────
# Leave blank to keep the AI Collaboration
# adapter DISABLED. The rest of the plugin
# works without this value.
AI_COLLABORATION_BASE_URL=

# Bearer token for AI Collaboration /mcp endpoint
AI_COLLABORATION_BEARER_TOKEN=

# ── Self-routing policy ───────────────────────
# Controls whether the Perplexity provider can
# appear in an AI Collaboration council when the
# request originates from this Perplexity connector.
#
# exclude_origin_provider (default & recommended):
#   Perplexity is excluded from the council for
#   its own requests. Prevents circular
#   self-corroboration.
#
# allow:
#   Perplexity may be included in council for
#   its own requests. Only enable if you
#   explicitly understand the corroboration risk.
PERPLEXITY_SELF_ROUTING=exclude_origin_provider

# ── Optional: request timeout (ms) ───────────
PLUGIN_REQUEST_TIMEOUT_MS=10000
