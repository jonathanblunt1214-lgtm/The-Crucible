{
  "$schema": "./.thecrucible.schema.json",
  "schemaVersion": 1,
  "project": {
    "name": "The Crucible",
    "projectId": "the-crucible"
  },
  "commands": {
    "verify": [
      { "name": "Engine tests", "run": "npm", "args": ["test"] }
    ]
  },
  "artifacts": ["package.json"],
  "clutter": {
    "allow": [],
    "allowDuplicateContent": false,
    "blockTrackedIgnored": true
  },
  "privacy": {
    "githubIdentity": "jonathanblunt1214-lgtm",
    "scanContactInformation": true
  },
  "security": {
    "allow": [
      { "path": "src/security.js", "reason": "The scanner defines the signatures it detects.", "owner": "jonathanblunt1214-lgtm", "expires": "2027-08-24" },
      { "path": "src/code-check.js", "reason": "The language-aware parser uses Node's compile-only API to validate changed JavaScript without executing it.", "owner": "jonathanblunt1214-lgtm", "expires": "2027-08-24" },
      { "path": "test/security.test.js", "reason": "Adversarial fixtures intentionally contain recognizable payloads.", "owner": "jonathanblunt1214-lgtm", "expires": "2027-08-24" },
      { "path": "test/hardening.test.js", "reason": "Hardening tests exercise dynamic-execution and dependency-policy fixtures.", "owner": "jonathanblunt1214-lgtm", "expires": "2027-08-24" }
    ],
    "allowBinaries": [],
    "dependencyAudit": [],
    "provenanceAudit": [],
    "dependencyPolicy": { "enabled": true, "denyGit": true, "denyHttp": true, "denyLocal": true, "allowedRegistryHosts": ["registry.npmjs.org"], "denyLicenses": ["GPL-3.0-only", "AGPL-3.0-only"] }
  },
  "authenticity": {
    "requireArtifacts": true,
    "claims": [
      { "name": "Engine test suite passes", "run": "npm", "args": ["test"], "evidence": ["package.json"] }
    ]
  },
  "codeCheck": {
    "commands": [
      { "name": "Affected Node tests", "run": "npm", "args": ["test"], "include": ["src/**", "test/**", "package.json", ".thecrucible.json", ".thecrucible.schema.json"], "failureAction": "test failure" }
    ]
  },
  "governance": { "requireExceptionMetadata": true, "failOnDisabledSecurity": true },
  "reproducibility": { "enabled": false, "commands": [], "artifacts": [] },
  "workload": {
    "workers": 2,
    "cycles": 2,
    "timeoutMinutes": 4,
    "maxOutputBytes": 1048576,
    "execution": { "network": "allow" }
  }
}
