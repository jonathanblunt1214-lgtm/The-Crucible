{
  "name": "the-crucible",
  "version": "0.1.0",
  "private": true,
  "description": "Repository-independent verification, stress, clutter, and Git maintenance gates.",
  "scripts": {
    "prepare": "node src/installGitHooks.js",
    "configure:suite": "node src/configureSuite.js",
    "test": "node src/testCadence.js changed",
    "test:all": "node src/testCadence.js all",
    "validate": "node src/cli.js validate",
    "audit:clutter": "node src/cli.js clutter",
    "lint:workflows": "node src/cli.js workflow-lint",
    "audit:design-brief": "node src/cli.js design-brief",
    "audit:core-ref": "node src/cli.js core-ref",
    "audit:reference-branches": "node src/referenceBranchIntegrity.js",
    "test:scientific-learning": "node --test test/scientificLearning.test.js",
    "test:safe-retrieval": "node --test test/safeInformationRetrieval.test.js",
    "test:automated-google-research": "node --test test/automatedGoogleResearch.test.js",
    "learning:google-research": "node src/automatedGoogleResearchCli.js run",
    "learning:google-research-readiness": "node src/automatedGoogleResearchCli.js readiness",
    "learning:extract": "node src/claimExtractionWorkerCli.js run",
    "learning:extract-readiness": "node src/claimExtractionWorkerCli.js readiness",
    "test:monthly-learning-refresh": "node --test test/monthlyKnowledgeRefresh.test.js",
    "learning:readiness": "node src/scientificLearningCli.js readiness",
    "learning:ingest": "node src/scientificLearningCli.js ingest",
    "learning:status": "node src/scientificLearningCli.js status",
    "learning:pre-soak": "node src/preSoakReadinessCli.js report",
    "learning:retrieve": "node src/scientificLearningCli.js retrieve",
    "learning:compare": "node src/scientificLearningCli.js compare",
    "repair:reference-branches": "node src/referenceBranchIntegrity.js repair",
    "audit:privacy": "node src/cli.js privacy",
    "audit:security": "node src/cli.js security",
    "audit:github-security": "node src/cli.js github-security",
    "audit:collisions": "node src/cli.js collisions",
    "audit:handoff": "node src/handoffPolicy.js",
    "audit:ai-conflict": "node src/aiConflictResolution.js",
    "audit:ai-conflict-governance": "node src/cli.js ai-conflicts",
    "audit:required-check": "node src/requiredCheckBoundary.js",
    "audit:commit": "node src/cli.js commit",
    "precheck": "node src/cli.js precheck",
    "fix:commit": "node src/cli.js fix-commit",
    "audit:governance": "node src/cli.js governance",
    "audit:authenticity": "node src/cli.js authenticity",
    "audit:reproducibility": "node src/cli.js reproducibility",
    "docs:sync": "node src/cli.js docs-sync",
    "docs:check": "node src/cli.js docs-check",
    "scrub:privacy": "node src/cli.js scrub",
    "repair": "node src/cli.js repair",
    "run": "node src/cli.js run",
    "maintain": "node src/cli.js maintain",
    "cadence:every-push": "node src/testCadence.js every-push",
    "cadence:daily": "node src/testCadence.js daily",
    "cadence:weekly": "node src/testCadence.js weekly",
    "cadence:monthly": "node src/testCadence.js monthly",
    "cadence:on-error": "node src/testCadence.js on-error",
    "audit:circulation": "node src/cli.js circulation"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "parse5": "^8.0.0",
    "postcss": "^8.5.23",
    "pyright": "^1.1.413",
    "tree-sitter": "^0.25.1",
    "tree-sitter-bash": "^0.25.1",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "tree-sitter@0.25.1": true,
    "tree-sitter-bash@0.25.1": true
  }
}
