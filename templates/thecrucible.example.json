{
  "$schema": "https://raw.githubusercontent.com/jonathanblunt1214-lgtm/The-Crucible/main/.thecrucible.schema.json",
  "schemaVersion": 1,
  "project": {
    "name": "Example project",
    "projectId": "example-project",
    "mainRepository": "octocat/example-web",
    "folderTopology": {
      "mode": "explicit",
      "folders": [
        { "path": "web", "roles": ["influences-main"], "links": ["123"] },
        { "path": "api", "roles": ["influences-main", "checks-only"], "links": ["123"] },
        { "path": "archive", "roles": ["archive"], "links": [] }
      ]
    }
  },
  "suite": {
    "mode": "all"
  },
  "commands": {
    "prepare": [
      { "name": "Install locked dependencies", "run": "npm", "args": ["ci"] }
    ],
    "verify": [
      { "name": "Tests", "run": "npm", "args": ["test"] },
      { "name": "Build", "run": "npm", "args": ["run", "build"] }
    ]
  },
  "artifacts": ["dist"],
  "clutter": {
    "allow": [],
    "allowDuplicateContent": false
  },
  "privacy": {
    "githubIdentity": "octocat"
  },
  "security": {
    "allow": [],
    "allowBinaries": [],
    "dependencyAudit": [
      { "name": "High-severity npm dependency audit", "run": "npm", "args": ["audit", "--audit-level=high", "--omit=dev"] }
    ]
  },
  "workload": {
    "workers": 4,
    "cycles": 2,
    "timeoutMinutes": 4,
    "maxOutputBytes": 1048576,
    "heartbeatSeconds": 60,
    "execution": { "network": "allow" }
  }
}
