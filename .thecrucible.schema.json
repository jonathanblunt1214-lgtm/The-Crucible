{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jonathanblunt1214-lgtm/The-Crucible/blob/main/.thecrucible.schema.json",
  "title": "The Crucible project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "commands"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verify"],
      "properties": {
        "prepare": { "$ref": "#/$defs/commands" },
        "verify": { "$ref": "#/$defs/commands" }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "clutter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": { "$ref": "#/$defs/exceptions" },
        "allowDuplicateContent": { "type": "boolean" },
        "blockTrackedIgnored": { "type": "boolean" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["githubIdentity"],
      "properties": {
        "githubIdentity": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" },
        "scanContactInformation": { "type": "boolean" },
        "allow": { "$ref": "#/$defs/exceptions" }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "allow": { "$ref": "#/$defs/exceptions" },
        "allowBinaries": { "$ref": "#/$defs/exceptions" },
        "maxTextBytes": { "type": "integer", "minimum": 1024, "maximum": 5242880 },
        "dependencyAudit": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/command" } },
        "provenanceAudit": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/command" } },
        "dependencyPolicy": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }, "denyGit": { "type": "boolean" }, "denyHttp": { "type": "boolean" }, "denyLocal": { "type": "boolean" },
            "allowedRegistryHosts": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1 } },
            "denyLicenses": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "authenticity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claims": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/command" } },
        "requireArtifacts": { "type": "boolean" }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requireExceptionMetadata": { "type": "boolean" },
        "failOnDisabledSecurity": { "type": "boolean" }
      }
    },
    "integrity": {
      "type": "object", "additionalProperties": false,
      "properties": { "digest": { "type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$" } }
    },
    "reproducibility": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "commands": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/command" } },
        "artifacts": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 240 } }
      }
    },
    "codeCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "run", "include", "failureAction"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 80 },
              "run": { "type": "string", "minLength": 1, "maxLength": 200 },
              "args": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 500 } },
              "cwd": { "type": "string", "minLength": 1, "maxLength": 240 },
              "include": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 240 } },
              "failureAction": { "enum": ["test failure", "security concern", "human code review required"] }
            }
          }
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workers": { "type": "integer", "minimum": 1, "maximum": 8 },
        "cycles": { "type": "integer", "minimum": 1, "maximum": 20 },
        "timeoutMinutes": { "type": "integer", "minimum": 1, "maximum": 30 },
        "maxOutputBytes": { "type": "integer", "minimum": 4096, "maximum": 10485760 },
        "execution": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "network": { "enum": ["allow", "deny"] },
            "memoryMb": { "type": "integer", "minimum": 1, "maximum": 65536 },
            "fileSizeMb": { "type": "integer", "minimum": 1, "maximum": 102400 },
            "processes": { "type": "integer", "minimum": 1, "maximum": 4096 }
            ,"denyBackground": { "type": "boolean" }
          }
        }
      }
    }
  },
  "$defs": {
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/command" }
    },
    "command": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "run"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "run": { "type": "string", "minLength": 1, "maxLength": 200 },
          "args": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 500 } },
          "cwd": { "type": "string", "minLength": 1, "maxLength": 240 },
          "evidence": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 240 } }
        }
    },
    "exceptions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1, "maxLength": 240 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 240 },
              "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
              "owner": { "type": "string", "minLength": 1, "maxLength": 100 },
              "expires": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
              ,"rules": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 100 } }
            }
          }
        ]
      }
    }
  }
}
