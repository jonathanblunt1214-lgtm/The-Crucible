{
  "schemaVersion": 1,
  "project": {
    "name": "<receiving-project-name>",
    "repository": "<owner/repository>",
    "crucibleRef": "<selected-crucible-commit-or-version>"
  },
  "preflight": {
    "completedBeforePackageFinalization": true,
    "status": "<verified|blocked>",
    "checkedAt": "<America/New_York timestamp>"
  },
  "injectionCredential": {
    "defaultState": "disabled",
    "enabled": false,
    "authorizationId": "<active-injection-authorization-id-or-null>",
    "targetRepository": "<owner/repository-or-null>",
    "windowStartsAt": "<timestamp-or-null>",
    "windowExpiresAt": "<timestamp-or-null>",
    "minimumScope": ["<least-required-permission>"],
    "allowedOperations": ["<injection-only-operation>"],
    "nonInjectionUseForbidden": true,
    "disableWhenNoActiveInjection": true,
    "shutdownCondition": "assimilation-complete-or-blocked-or-cancelled-or-window-expired",
    "credentialValueStored": false
  },
  "monitoringLink": {
    "defaultState": "disabled",
    "state": "disabled",
    "authorizationId": "<active-injection-authorization-id-or-null>",
    "targetRepository": "<owner/repository>",
    "developmentBranch": "<designated-development-branch>",
    "activatedAt": "<timestamp-or-null>",
    "expiresAt": "<timestamp-no-more-than-24-hours-after-activation-or-null>",
    "maximumLifetimeHours": 24,
    "allowedWorkflowOrCheckScope": ["<applicable-crucible-or-native-validation>"],
    "minimumReadScope": ["actions:read", "contents:read"],
    "minimumRepairScope": ["<least-write-scope-required-by-authorized-injection-or-none>"],
    "fetchFailedJobStepAndLogs": true,
    "deduplicateByUnderlyingDefect": true,
    "repairPayloadRequired": true,
    "automaticRepairAndRetestWhenAuthorized": true,
    "disableWhenNoActiveInjection": true,
    "nonInjectionUseForbidden": true,
    "lastDefectFingerprint": null,
    "lastObservedRunId": null,
    "repairState": "<disabled|monitoring|repairing|retest|resolved|blocked|expired>",
    "secretValueStored": false
  },
  "prerequisites": [
    {
      "id": "<stable-id>",
      "type": "<branch|repository-setting|actions-permission|secret|credential|ruleset|external-service|native-validation|monitoring|other>",
      "name": "<non-secret prerequisite name>",
      "requiredBy": "<injected capability/check>",
      "reason": "<why required>",
      "minimumScope": "<least required permission or null>",
      "verified": false,
      "remediation": "<exact non-secret remediation or null>"
    }
  ],
  "nativeValidation": {
    "discoveredBeforePackageFinalization": true,
    "fullTestCommands": ["<project-native-full-test-command>"],
    "stressReleaseOrBoundedWorkloadCommands": ["<project-native-stress-or-release-command>"],
    "validators": [
      {
        "path": "<project-owned-validator-path>",
        "purpose": "<clutter|duplicate|inventory|governance|security|runtime-wiring|other>",
        "duplicatesOrParallelsCrucibleRule": false,
        "governedConfigSource": "<config-or-allow-list-path-or-null>",
        "consistentWithAssimilatedGovernance": false,
        "remediation": "<required reconciliation or null>"
      }
    ],
    "postAssimilation": {
      "status": "<pending|repairing|passed|blocked>",
      "cruciblePassed": false,
      "nativeValidationPassed": false,
      "duplicatedValidatorsReconciled": false,
      "automaticRepairLoopRequiredOnFailure": true,
      "lastVerifiedDevelopmentCommit": "<sha-or-null>"
    }
  },
  "activation": {
    "allRequiredPrerequisitesVerified": false,
    "monitoringLinkMayActivate": false,
    "requiredGatesMayActivate": false,
    "productionPromotionAllowed": false,
    "assimilationMayComplete": false
  },
  "secretValueStorageForbidden": true
}
